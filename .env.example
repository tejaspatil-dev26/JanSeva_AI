# ==============================================================================
# JANSEVA AI - ENVIRONMENT CONFIGURATION
# Tagline: "Your Rights. Your Benefits. One Simple Conversation."
# ==============================================================================

# Application
PROJECT_NAME="JanSeva AI"
SECRET_KEY="janseva-production-grade-secret-key-2026"
DATABASE_URL="sqlite:///./janseva.db"

# AI Provider Configurations
# Options: "gemini", "openai", "mock" (offline rule & domain engine)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Document Storage & OCR
UPLOAD_DIR="./uploads"

# Browser Automation & Government Portal Adapter
ENABLE_PLAYWRIGHT=true
MOCK_PORTAL_GATEWAY_URL="http://127.0.0.1:8000/api/v1/mock-portal"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000
